# Every 15 minutes: a fetch plus an ls-remote is cheap, and a short cycle keeps the
# freshness alarm's 120-minute window far away. Persistent=true so a machine that was
# down syncs once on the way back instead of waiting a whole cycle.
[Unit]
Description=Push the e2e mirror every 15 minutes

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=60
Persistent=true
Unit=e2e-mirror-sync.service

[Install]
WantedBy=timers.target
