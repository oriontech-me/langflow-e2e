[Unit]
# The coverage-matrix routine (stage 3, task 7): the matrix's derivable axes refreshed on
# the source's main, committed when they moved, and the feed sent to the QA platform when
# its endpoint is configured. See ops/vm/run-coverage-matrix.sh; the shape every routine
# shares is ops/vm/lib/routine.sh.
Description=E2E coverage-matrix routine: refresh the derivable axes on main (VM lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# systemd sets no HOME for a system service (#1715).
Environment=HOME=/root
ExecStart=/root/e2e-qa/ops/vm/run-coverage-matrix.sh
# 2 = skipped (the daily lane held the machine past the budget), 4 = blocked: said by
# the watchdog, and not a broken unit. This routine never ends blocked; 4 is declared
# because every routine's unit reads the same (scripts/ops-units.test.mjs).
SuccessExitStatus=2 4
# Up to 60 min waiting for the daily lane, then about a minute of work, three times at
# most when main keeps moving. Well above all of it.
TimeoutStartSec=90min
TimeoutStopSec=2min
