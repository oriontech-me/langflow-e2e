# Can this machine still reach the destination host? Probes hourly and posts only when
# the answer has been "no" for THRESHOLD looks in a row, and once when it comes back
# (#2422). See scripts/destination-reachability-alarm.sh for the threshold and why.
#
# Install:
#   cp ops/systemd/e2e-destination-reachability.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now e2e-destination-reachability.timer
[Unit]
Description=Can the VM still reach the destination host?
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOME and PATH for the reasons e2e-mirror-freshness.service gives: systemd sets no
# HOME (#1715), and its default PATH omits what the credential check needs (node).
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/e2e-qa
ExecStart=/root/e2e-qa/scripts/destination-reachability-alarm.sh
