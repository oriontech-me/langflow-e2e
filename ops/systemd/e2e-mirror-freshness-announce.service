# The one mirror message the channel gets: posted before the daily, and only if the
# mirror is behind at that moment. See scripts/mirror-freshness-alarm.sh for why the
# hourly unit records and never posts.
#
# Install:
#   cp ops/systemd/e2e-mirror-freshness-announce.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now e2e-mirror-freshness-announce.timer
[Unit]
Description=Tell the channel if the e2e mirror is behind before the daily
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOME and PATH for the reasons e2e-mirror-freshness.service gives: systemd sets no
# HOME (#1715), and its default PATH omits what the check needs.
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ANNOUNCE=1
WorkingDirectory=/root/e2e-qa
ExecStart=/root/e2e-qa/scripts/mirror-freshness-alarm.sh
