# Asks whether the suite the VM lane reads is still what `main` holds, and says so when
# the answer changes. See scripts/mirror-freshness-alarm.sh for why it is a change
# notifier rather than an hourly repeat.
#
# Versioned here rather than living only in /root: the machine that carries the verdict
# should not be less reproducible than the one that does not (the debt task 3 is about).
#
# Install:
#   cp ops/systemd/e2e-mirror-freshness.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now e2e-mirror-freshness.timer
[Unit]
Description=Is the e2e mirror still following main?
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOME is set for the same reason #1715 exists: a systemd unit does not have one, and
# the state file and git both look for it. WorkingDirectory is the clone the lane runs.
Environment=HOME=/root
WorkingDirectory=/root/e2e-qa
ExecStart=/root/e2e-qa/scripts/mirror-freshness-alarm.sh
